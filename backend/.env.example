# Names only. Request every value from the project owner via the orchestrator; never commit real values.
# The process environment must contain them; the API does not load .env itself.
PPE_API_CONFIG=config/api.local.yaml
PPE_ALLOWED_NETWORKS=            # comma-separated IP/CIDR list, e.g. 127.0.0.1/32 (a /0 network is refused)
PPE_USERS_FILE=                  # YAML of named users with scrypt hashes (scripts/make_user.py); and/or the bootstrap pair below
PPE_SUPERVISOR_USER=
PPE_SUPERVISOR_PASSWORD=         # at least 12 characters
PPE_READONLY_USER=               # optional pair; must differ from the supervisor's
PPE_READONLY_PASSWORD=
PPE_AUTH_MAX_FAILURES=           # optional, default 10 failed logins per peer ...
PPE_AUTH_FAILURE_WINDOW_SECONDS= # ... per window, default 300 (lockout answers 429 with Retry-After)
PPE_AUDIT_LOG=                   # optional path; written with file mode 0600
PPE_TLS_CERT=                    # PEM files: serve HTTPS (required for any non-loopback bind)
PPE_TLS_KEY=
